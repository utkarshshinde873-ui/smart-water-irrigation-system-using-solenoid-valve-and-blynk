  "projects": {
    "*": {
      "files": {
        "sketch.ino": "// Mokxi.\n// This circuit has no board, so Run simulates the parts only.\n// Add a board and pick a program in its Firmware panel: the editor then shows\n// that program's source, and Run builds what you type here for that board.\n\nvoid setup() {\n  pinMode(13, OUTPUT);\n  Serial.begin(115200);\n}\n\nvoid loop() {\n  digitalWrite(13, HIGH);\n  delay(500);\n  digitalWrite(13, LOW);\n  delay(500);\n}\n"
      },
      "main": "sketch.ino"
    },
    "xiaoc31": {
      "files": {
        "sketch.ino": "// XIAO ESP32-C3\n// 8-channel relay module\n// 5 solenoid valve outputs\n\n// Relay pin assignments\nconst int MAIN_VALVE = D6;\nconst int FARM1_VALVE = D5;\nconst int FARM2_VALVE = D10;\nconst int FARM3_VALVE = D8;\nconst int FARM4_VALVE = D7;\n\n// Most relay modules are active-LOW.\n// Change to false if your relay module is active-HIGH.\nconst bool RELAY_ACTIVE_LOW = true;\n\nconst int relayPins[] = {\n  MAIN_VALVE,\n  FARM1_VALVE,\n  FARM2_VALVE,\n  FARM3_VALVE,\n  FARM4_VALVE\n};\n\nconst int RELAY_COUNT = 5;\n\nvoid setRelay(int pin, bool on) {\n  if (RELAY_ACTIVE_LOW) {\n    digitalWrite(pin, on ? LOW : HIGH);\n  } else {\n    digitalWrite(pin, on ? HIGH : LOW);\n  }\n}\n\nvoid allRelaysOff() {\n  for (int i = 0; i < RELAY_COUNT; i++) {\n    setRelay(relayPins[i], false);\n  }\n}\n\nvoid setup() {\n  Serial.begin(115200);\n\n  // Set all outputs OFF.\n  for (int i = 0; i < RELAY_COUNT; i++) {\n    digitalWrite(\n      relayPins[i],\n      RELAY_ACTIVE_LOW ? HIGH : LOW\n    );\n    pinMode(relayPins[i], OUTPUT);\n  }\n\n  allRelaysOff();\n\n  Serial.println(\"Solenoid relay test started.\");\n  Serial.println(\"All valves should be OFF initially.\");\n}\n\nvoid loop() {\n  // Test main valve\n  Serial.println(\"Main valve relay ON\");\n  setRelay(MAIN_VALVE, true);\n  delay(2000);\n  setRelay(MAIN_VALVE, false);\n  delay(1000);\n\n  // Test Farm 1\n  Serial.println(\"Farm 1 relay ON\");\n  setRelay(MAIN_VALVE, true);\n  delay(500);\n  setRelay(FARM1_VALVE, true);\n  delay(2000);\n  setRelay(FARM1_VALVE, false);\n  setRelay(MAIN_VALVE, false);\n  delay(1000);\n\n  // Test Farm 2\n  Serial.println(\"Farm 2 relay ON\");\n  setRelay(MAIN_VALVE, true);\n  delay(500);\n  setRelay(FARM2_VALVE, true);\n  delay(2000);\n  setRelay(FARM2_VALVE, false);\n  setRelay(MAIN_VALVE, false);\n  delay(1000);\n\n  // Test Farm 3\n  Serial.println(\"Farm 3 relay ON\");\n  setRelay(MAIN_VALVE, true);\n  delay(500);\n  setRelay(FARM3_VALVE, true);\n  delay(2000);\n  setRelay(FARM3_VALVE, false);\n  setRelay(MAIN_VALVE, false);\n  delay(1000);\n\n  // Test Farm 4\n  Serial.println(\"Farm 4 relay ON\");\n  setRelay(MAIN_VALVE, true);\n  delay(500);\n  setRelay(FARM4_VALVE, true);\n  delay(2000);\n  setRelay(FARM4_VALVE, false);\n  setRelay(MAIN_VALVE, false);\n  delay(2000);\n}"
      },
      "main": "sketch.ino"
    }
  }
